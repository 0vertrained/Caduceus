# Copy to .env (never commit .env). Every value here is for a developer's machine.

# Signs de-identification stamps. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CADUCEUS_DEID_KEY=

# The password docker compose gives its Postgres, and the API's URL for it (docs/postgres.md). Use one that needs
# no escaping in a URL:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CADUCEUS_DB_PASSWORD=

# dev = pick a demo user on the sign-in screen (bound to 127.0.0.1 by docker-compose). oidc = sign in with an
# identity provider (docs/sign-in.md): the local Keycloak, with `docker compose --profile oidc up --build`, unless the
# four settings below name another. Their defaults, in docker-compose.yml, are the local Keycloak's.
CADUCEUS_AUTH_MODE=dev
# CADUCEUS_OIDC_ISSUER=http://localhost:8080/realms/mesaverde
# CADUCEUS_OIDC_JWKS_URL=http://keycloak:8080/realms/mesaverde/protocol/openid-connect/certs
# CADUCEUS_OIDC_AUDIENCE=caduceus-api
# CADUCEUS_OIDC_CLIENT_ID=caduceus-ui

# The local Keycloak's passwords (`--profile oidc`, 12 characters or more): its administrator's (user admin, at
# http://localhost:8080/admin), and the one each of the six people signs in with (dolores, dr.reyes, dr.lee, dr.patel,
# avery, sam). Make each with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
CADUCEUS_KEYCLOAK_ADMIN_PASSWORD=
CADUCEUS_KEYCLOAK_USER_PASSWORD=

# The model inside the network. With `--profile llm`, the same image the demo runs (infra/model):
# CADUCEUS_IN_VPC_URL=http://model:8081/v1
CADUCEUS_IN_VPC_MODEL=qwen2.5-1.5b-instruct
# 0 keeps drafts off it (it still writes the chart summaries), for a model too slow to draft on this machine's CPU.
# CADUCEUS_IN_VPC_DRAFTS=0

# Optional external model for de-identified drafting only. Leave empty to keep every call in-VPC.
CADUCEUS_EXTERNAL_API_KEY=
